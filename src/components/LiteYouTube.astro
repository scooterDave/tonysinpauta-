---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { watchUrl, ytThumb } from '../lib/format';
import { WIDE_ASPECT } from '../lib/youtube-feed';

interface Props {
  id: string;
  title: string;
  /** Local still optimized by Astro; YouTube's own stills are used otherwise. */
  image?: ImageMetadata;
  /** Extra, larger YouTube still (e.g. sddefault) when known to exist. */
  largeThumb?: { src: string; width: number };
  aspect?: number;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  id,
  title,
  image,
  largeThumb,
  aspect = WIDE_ASPECT,
  sizes = '(min-width: 64rem) 24rem, 80vw',
  loading = 'lazy',
  size = 'md',
  class: className,
} = Astro.props;

const framed = aspect < 1.6;
const hq = ytThumb(id, 'hqdefault');
const srcset = [`${ytThumb(id, 'mqdefault')} 320w`, `${hq} 480w`, largeThumb && `${largeThumb.src} ${largeThumb.width}w`]
  .filter(Boolean)
  .join(', ');
---

<div
  class:list={['yt', `yt--${size}`, framed && 'yt--framed', className]}
  data-yt-id={id}
  data-yt-title={title}
  style={framed ? `--content-aspect: ${aspect}` : undefined}
>
  <a class="yt__link" href={watchUrl(id)} data-yt-play>
    {framed && <img class="yt__backdrop" src={hq} alt="" width="480" height="360" loading={loading} decoding="async" />}
    <span class="yt__frame">
      {
        image ? (
          <Image
            class="yt__thumb"
            src={image}
            alt=""
            widths={[360, 640, 960, 1280]}
            sizes={sizes}
            loading={loading}
            fetchpriority={loading === 'eager' ? 'high' : 'auto'}
          />
        ) : (
          <img
            class="yt__thumb"
            src={hq}
            srcset={srcset}
            sizes={sizes}
            alt=""
            width="480"
            height="360"
            loading={loading}
            decoding="async"
          />
        )
      }
    </span>
    <span class="yt__play" aria-hidden="true"><Icon name="play" /></span>
    <span class="sr-only">Reproducir: {title}</span>
  </a>
</div>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-md);
    background: var(--bg-elevated);
    isolation: isolate;
  }

  .yt__link {
    position: absolute;
    inset: 0;
    display: block;
    border-radius: inherit;
  }

  .yt__link::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-card-shade);
    pointer-events: none;
  }

  .yt__frame {
    position: absolute;
    inset: 0;
    display: block;
  }

  .yt--framed .yt__frame {
    left: 50%;
    right: auto;
    height: 100%;
    width: auto;
    aspect-ratio: var(--content-aspect);
    transform: translateX(-50%);
    box-shadow: var(--shadow-card);
  }

  .yt__thumb,
  .yt__backdrop {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .yt__backdrop {
    position: absolute;
    inset: 0;
    transform: scale(2.6);
    filter: blur(14px) brightness(0.55) saturate(1.3);
  }

  .yt__play {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-pill);
    background: var(--play-bg);
    color: var(--text-on-brand);
    box-shadow: var(--shadow-button);
    transform: translate(-50%, -50%);
    transition: transform 200ms var(--ease-out);
  }

  .yt--lg .yt__play {
    width: 4.75rem;
    height: 4.75rem;
  }

  .yt__play :global(svg) {
    width: 45%;
    height: 45%;
    transform: translateX(8%);
  }

  .yt__link:hover .yt__play,
  .yt__link:focus-visible .yt__play {
    transform: translate(-50%, -50%) scale(1.08);
  }

  .yt__link:focus-visible {
    box-shadow: var(--focus-ring);
  }

  .yt.is-playing :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .yt--framed.is-playing {
    width: min(100%, calc(80svh * var(--content-aspect)));
    aspect-ratio: var(--content-aspect);
    margin-inline: auto;
  }
</style>

<script>
  const EMBED = 'https://www.youtube-nocookie.com/embed/';
  let warmed = false;

  const isFacade = (target: EventTarget | null) =>
    target instanceof Element ? target.closest<HTMLAnchorElement>('[data-yt-play]') : null;

  function warm(event: Event) {
    if (warmed || !isFacade(event.target)) return;
    warmed = true;
    for (const href of ['https://www.youtube-nocookie.com', 'https://i.ytimg.com', 'https://www.google.com']) {
      const link = document.createElement('link');
      link.rel = 'preconnect';
      link.href = href;
      document.head.append(link);
    }
  }

  document.addEventListener('pointerover', warm, { passive: true });
  document.addEventListener('focusin', warm);

  document.addEventListener('click', (event) => {
    if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
    const link = isFacade(event.target);
    const box = link?.closest<HTMLElement>('[data-yt-id]');
    if (!box) return;
    event.preventDefault();

    const iframe = document.createElement('iframe');
    iframe.src = `${EMBED}${box.dataset.ytId}?autoplay=1&rel=0&playsinline=1`;
    iframe.title = box.dataset.ytTitle ?? 'Video de YouTube';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    box.classList.add('is-playing');
    box.replaceChildren(iframe);
    iframe.focus();
  });
</script>
