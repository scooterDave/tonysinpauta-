---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import VideoCard from '../VideoCard.astro';
import { CHANNEL } from '../../data/site';
import { getSinPautaTvPlaylist } from '../../lib/playlist';
import { getLatestVideos } from '../../lib/videos';

// Sin Pauta TV already plays everything in its tracklist; this shelf only shows uploads it doesn't list,
// so it stays hidden while the player runs on the channel's uploads playlist.
const [{ videos }, { tracks }] = await Promise.all([getLatestVideos(), getSinPautaTvPlaylist()]);
const inPlayer = new Set(tracks.map((t) => t.id));
const fresh = videos.filter((v) => !inPlayer.has(v.id)).slice(0, 6);
---

{
  fresh.length > 0 && (
    <section class="section latest" id="recientes" aria-labelledby="recientes-title">
      <div class="container">
        <SectionHeading id="recientes-title" kicker="Recién subido" title="También nuevo en el canal">
          Lo último que Tony ha subido a YouTube y que todavía no está en Sin Pauta TV.
        </SectionHeading>
      </div>

      <ul class="shelf" role="list" aria-label="Videos recientes del canal">
        {fresh.map((video) => (
          <li>
            <VideoCard video={video} sizes="(min-width: 64rem) 24rem, (min-width: 48rem) 45vw, 78vw" />
          </li>
        ))}
      </ul>

      <div class="container latest__more">
        <a class="btn btn--ghost" href={CHANNEL.videosUrl}>
          <Icon name="youtube" />
          Ver todos los videos en YouTube
        </a>
      </div>
    </section>
  )
}

<style>
  .latest__more {
    display: flex;
    justify-content: center;
    margin-top: var(--space-xl);
  }
</style>
