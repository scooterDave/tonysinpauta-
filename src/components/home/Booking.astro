---
import Icon from '../Icon.astro';
import SectionHeading from '../SectionHeading.astro';
import { CONTACT } from '../../data/site';

const SERVICES = [
  {
    icon: 'music',
    title: 'Promoción musical',
    text: '¿Tienes tema nuevo o video recién salido? Tony presenta estrenos de bachata y merengue en el canal.',
  },
  {
    icon: 'calendar',
    title: 'Contrataciones',
    text: '¿Tienes una fiesta, un evento o una actividad? Coordina directamente con Tony la fecha y los detalles.',
  },
  {
    icon: 'megaphone',
    title: 'Anúnciate',
    text: 'Dale visibilidad a tu negocio frente a la comunidad que sigue Tony Sin Pauta.',
  },
] as const;
---

<section class="section booking" id="contrataciones" aria-labelledby="contrataciones-title">
  <div class="container">
    <SectionHeading id="contrataciones-title" number="05" kicker="Contrataciones y promoción" title="¿Tienes algo que promocionar?">
      Artistas, organizadores de eventos y negocios: hablen directo con Tony por llamada o por WhatsApp.
    </SectionHeading>

    <div class="booking__grid">
      <ul class="booking__services" role="list">
        {
          SERVICES.map((service) => (
            <li class="service">
              <span class="service__icon">
                <Icon name={service.icon} />
              </span>
              <div>
                <h3 class="service__title">{service.title}</h3>
                <p class="service__text">{service.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="hotline">
        <p class="kicker hotline__kicker">
          <Icon name="mic" />
          Llamadas y WhatsApp
        </p>
        <p class="hotline__number">
          <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
        </p>
        <div class="hotline__actions">
          <a class="btn btn--whatsapp" href={CONTACT.whatsappHref}>
            <Icon name="whatsapp" />
            Escríbele por WhatsApp
          </a>
          <a class="btn btn--ghost" href={CONTACT.phoneHref}>
            <Icon name="phone" />
            Llamar ahora
          </a>
        </div>
        <p class="hotline__note">Cuéntale qué necesitas, para qué fecha y dónde.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .booking {
    border-top: var(--border-width) solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .booking__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .booking__services {
    display: grid;
    gap: var(--space-md);
  }

  .service {
    display: flex;
    gap: var(--space-md);
    padding: var(--space-lg);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-canvas);
  }

  .service__icon {
    flex: none;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-md);
    background: var(--brand-blue);
    color: var(--text-on-brand);
  }

  .service__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .service__title {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .service__text {
    color: var(--text-secondary);
  }

  .hotline {
    position: relative;
    display: grid;
    gap: var(--space-md);
    align-content: center;
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-lg);
    background: var(--gradient-hotline);
    box-shadow: var(--shadow-monitor);
    overflow: hidden;
    isolation: isolate;
  }

  .hotline::after {
    content: '';
    position: absolute;
    inset: auto -10% -40% auto;
    z-index: -1;
    width: 18rem;
    height: 18rem;
    border-radius: var(--radius-pill);
    background: var(--glow-red);
    filter: blur(40px);
  }

  .hotline__kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .hotline__kicker :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .hotline__number {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    letter-spacing: var(--tracking-display);
    line-height: 0.9;
  }

  .hotline__number a {
    text-decoration: none;
  }

  .hotline__number a:hover {
    color: var(--brand-gold);
  }

  .hotline__actions {
    display: grid;
    gap: var(--space-sm);
  }

  .hotline__note {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  @media (min-width: 30rem) {
    .hotline__actions {
      display: flex;
      flex-wrap: wrap;
    }
  }

  @media (min-width: 64rem) {
    .booking__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-2xl);
      align-items: stretch;
    }

    .hotline {
      padding: var(--space-2xl);
    }
  }
</style>
