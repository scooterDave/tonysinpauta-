---
import Icon from '../Icon.astro';
import LiteYouTube from '../LiteYouTube.astro';
import SectionHeading from '../SectionHeading.astro';
import { INTERVIEWS } from '../../data/featured';
import { watchUrl } from '../../lib/format';
---

<section class="section interviews" id="entrevistas" aria-labelledby="entrevistas-title">
  <div class="container">
    <SectionHeading id="entrevistas-title" number="02" kicker="Entrevistas sin filtro" title="Las más vistas del canal">
      Conversaciones directas con figuras de la bachata y el merengue. Sin libreto y sin pelos en la lengua.
    </SectionHeading>

    <div class="interviews__grid">
      {
        INTERVIEWS.map((item, i) => (
          <article class:list={['icard', i === 0 && 'icard--lead']}>
            <LiteYouTube
              id={item.id}
              title={item.youtubeTitle}
              image={item.image}
              size={i === 0 ? 'lg' : 'md'}
              sizes={i === 0 ? '(min-width: 64rem) 44rem, 92vw' : '(min-width: 64rem) 28rem, 92vw'}
            />
            <div class="icard__body">
              <p class="icard__guest kicker">{item.guest}</p>
              <h3 class="icard__headline">{item.headline}</h3>
              <p class="icard__foot">
                <span class="icard__views">{item.views}</span>
                <a class="text-link" href={watchUrl(item.id)}>
                  YouTube
                  <Icon name="external" />
                  <span class="sr-only">: {item.guest}</span>
                </a>
              </p>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .interviews {
    position: relative;
    border-block: var(--border-width) solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .interviews__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .icard {
    display: grid;
    gap: var(--space-md);
    align-content: start;
  }

  .icard__body {
    display: grid;
    gap: var(--space-xs);
    padding-left: var(--space-md);
    border-left: 3px solid var(--brand-red);
  }

  .icard__headline {
    font-family: var(--font-display);
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .icard--lead .icard__headline {
    font-size: var(--font-size-3xl);
  }

  .icard__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    margin-top: var(--space-2xs);
  }

  .icard__views {
    font-family: var(--font-mono);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-bold);
    color: var(--text-primary);
  }

  @media (min-width: 48rem) {
    .interviews__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .icard--lead {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .interviews__grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      grid-template-rows: auto auto;
      gap: var(--space-xl) var(--space-2xl);
    }

    .icard--lead {
      grid-column: 1;
      grid-row: 1 / span 2;
    }
  }
</style>
