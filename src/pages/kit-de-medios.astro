---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import InquiryForm from '../components/InquiryForm.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { CHANNEL, CONTACT } from '../data/site';
import { KIT_AS_OF, KIT_AUDIENCE, KIT_FORMATS, KIT_NUMBERS, KIT_PACKAGES } from '../data/media-kit';
---

<BaseLayout
  title="Kit de medios | Anúnciate con Tony Sin Pauta"
  description="Kit de medios de Tony Sin Pauta: números del canal, formatos del show y opciones para anunciar tu negocio o promocionar tu música con Tony González."
  path="kit-de-medios/"
  isHome={false}
>
  <section class="kit-hero" aria-labelledby="kit-title">
    <div class="container kit-hero__inner">
      <p class="kicker">Kit de medios · {CHANNEL.name}</p>
      <h1 class="kit-hero__title" id="kit-title">Anúnciate en <span>{CHANNEL.tagline}</span></h1>
      <p class="kit-hero__lede">
        Tony González presenta tu negocio, tu marca o tu música frente a la comunidad dominicana y latina que sigue el show en
        YouTube.
      </p>
      <div class="kit-hero__ctas">
        <a class="btn btn--primary" href="#consulta-kit">
          <Icon name="send" />
          Pedir información
        </a>
        <a class="btn btn--ghost" href={CONTACT.whatsappHref}>
          <Icon name="whatsapp" />
          WhatsApp
        </a>
      </div>

      <ul class="kit-numbers" role="list" aria-label="El canal en números">
        {
          KIT_NUMBERS.map((n) => (
            <li>
              <strong>{n.value}</strong>
              <span>{n.label}</span>
            </li>
          ))
        }
      </ul>
      <p class="kit-hero__source">Cifras públicas del canal de YouTube a {KIT_AS_OF}.</p>
    </div>
  </section>

  <section class="section kit-audience" aria-labelledby="kit-audiencia">
    <div class="container">
      <SectionHeading id="kit-audiencia" number="01" kicker="Audiencia y región" title="¿Quién ve el show?" />
      <ul class="kit-cards kit-cards--three" role="list">
        {
          KIT_AUDIENCE.map((a) => (
            <li class="kit-card">
              <h3 class="kit-card__title">{a.title}</h3>
              <p class="kit-card__text">{a.text}</p>
            </li>
          ))
        }
      </ul>
      <p class="kit-aside">
        <Icon name="chart" />
        <span>Datos de audiencia por país y ciudad: <strong>a consultar con Tony.</strong></span>
      </p>
    </div>
  </section>

  <section class="section kit-formats" aria-labelledby="kit-formatos">
    <div class="container">
      <SectionHeading id="kit-formatos" number="02" kicker="Formatos" title="Lo que sale en el canal" />
      <ul class="kit-cards" role="list">
        {
          KIT_FORMATS.map((f) => (
            <li class="kit-card">
              <span class="kit-card__icon">
                <Icon name={f.icon} />
              </span>
              <h3 class="kit-card__title">{f.title}</h3>
              <p class="kit-card__text">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section kit-packages" aria-labelledby="kit-paquetes">
    <div class="container">
      <SectionHeading id="kit-paquetes" number="03" kicker="Paquetes" title="Opciones para anunciarte">
        Cada paquete se arma a la medida con Tony, según tu negocio, tu tema o tu evento.
      </SectionHeading>
      <ul class="kit-cards" role="list">
        {
          KIT_PACKAGES.map((p) => (
            <li class="kit-card kit-card--package">
              <h3 class="kit-card__title">{p.title}</h3>
              <p class="kit-card__text">{p.text}</p>
              <p class="kit-card__price">Precios a consultar</p>
              <a class="text-link" href="#consulta-kit" data-kit-type={p.type}>
                Consultar
                <Icon name="arrow" />
                <span class="sr-only">: {p.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section kit-contact" id="consulta-kit" aria-labelledby="kit-contacto">
    <div class="container kit-contact__grid">
      <div class="kit-contact__intro">
        <SectionHeading id="kit-contacto" number="04" kicker="Contacto" title="Hablemos de tu anuncio">
          Escríbele a Tony con lo que quieres promocionar y para cuándo. Te responde con precios y fechas disponibles.
        </SectionHeading>
        <ul class="kit-contact__list" role="list">
          <li>
            <a class="text-link" href={CONTACT.whatsappHref}><Icon name="whatsapp" /> WhatsApp {CONTACT.phoneDisplay}</a>
          </li>
          <li>
            <a class="text-link" href={CONTACT.phoneHref}><Icon name="phone" /> Llamar al {CONTACT.phoneDisplay}</a>
          </li>
          {
            CONTACT.email && (
              <li>
                <a class="text-link" href={CONTACT.emailHref}>
                  <Icon name="mail" /> {CONTACT.email}
                </a>
              </li>
            )
          }
        </ul>
      </div>
      <InquiryForm id="kit" defaultType="Anuncio o patrocinio" />
    </div>
  </section>
</BaseLayout>

<style>
  .kit-hero {
    padding-block: var(--space-2xl) var(--space-3xl);
    background: var(--gradient-stars), var(--gradient-hero);
  }

  .kit-hero__inner {
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }

  .kit-hero__title {
    font-family: var(--font-display);
    font-size: var(--font-size-4xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-display);
    line-height: 0.92;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .kit-hero__title span {
    color: var(--brand-gold);
  }

  .kit-hero__lede {
    max-width: 38rem;
    color: var(--text-secondary);
    font-size: var(--font-size-lg);
    text-wrap: pretty;
  }

  .kit-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .kit-numbers {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm);
    width: 100%;
    margin-top: var(--space-md);
  }

  .kit-numbers li {
    display: grid;
    gap: var(--space-2xs);
    align-content: start;
    padding: var(--space-md);
    border: var(--border-width) solid var(--border-strong);
    border-top: 3px solid var(--brand-red);
    border-radius: var(--radius-md);
    background: var(--bg-scrim);
  }

  .kit-numbers strong {
    font-family: var(--font-display);
    font-size: var(--font-size-3xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-display);
    line-height: 1;
    color: var(--brand-gold);
  }

  .kit-numbers span {
    color: var(--text-secondary);
    font-size: var(--font-size-sm);
  }

  .kit-hero__source {
    color: var(--text-secondary);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .kit-formats,
  .kit-contact {
    border-top: var(--border-width) solid var(--border-subtle);
    background: var(--bg-surface);
  }

  .kit-cards {
    display: grid;
    gap: var(--space-md);
  }

  .kit-card {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding: var(--space-lg);
    border: var(--border-width) solid var(--border-subtle);
    border-radius: var(--radius-md);
    background: var(--bg-canvas);
  }

  .kit-card__icon {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-bottom: var(--space-xs);
    border-radius: var(--radius-md);
    background: var(--brand-blue);
    color: var(--text-on-brand);
  }

  .kit-card__icon :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  .kit-card__title {
    font-family: var(--font-display);
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-regular);
    letter-spacing: var(--tracking-display);
    text-transform: uppercase;
  }

  .kit-card__text {
    color: var(--text-secondary);
  }

  .kit-card--package {
    border-left: 3px solid var(--brand-red);
    background: var(--gradient-hotline);
  }

  .kit-card__price {
    justify-self: start;
    margin-block: var(--space-xs);
    padding: var(--space-2xs) var(--space-xs);
    border-radius: var(--radius-sm);
    background: var(--brand-gold-soft);
    color: var(--brand-gold);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .kit-aside {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
    color: var(--text-secondary);
  }

  .kit-aside :global(svg) {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--brand-gold);
  }

  .kit-aside strong {
    color: var(--text-primary);
  }

  .kit-contact {
    scroll-margin-top: var(--header-h);
  }

  .kit-contact__grid {
    display: grid;
    gap: var(--space-xl);
  }

  .kit-contact__list {
    display: grid;
    gap: var(--space-sm);
  }

  .kit-contact__list a {
    overflow-wrap: anywhere;
  }

  @media (min-width: 48rem) {
    .kit-numbers {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .kit-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .kit-hero {
      padding-block: var(--space-3xl);
    }

    .kit-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .kit-contact__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--space-2xl);
    }
  }
</style>

<script>
  document.addEventListener('click', (event) => {
    const link = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-kit-type]') : null;
    const select = document.querySelector<HTMLSelectElement>('#consulta-kit select[name="tipo"]');
    if (link && select) select.value = link.dataset.kitType ?? '';
  });
</script>
